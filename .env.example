# =====================================================================
# MAI · variables de entorno — SOLO NOMBRES, VALORES VACÍOS
# Copiar a .env y rellenar. .env está en .gitignore y nunca se versiona.
# =====================================================================

# --- Servicio externo simulado (etapas 1, 2 y 4) ---------------------
# Token público, publicado en el README del material entregado.
# Aun así va por variable de entorno: coherencia sobre excepciones.
MAI_MOCK_URL=http://localhost:8080
MAI_MOCK_TOKEN=
MAI_MOCK_TIMEOUT_S=10
MAI_MOCK_REINTENTOS=3

# --- Enrutamiento del proveedor de IA (ver docs/adr/ADR-004) ---------
# Cadena ordenada, separada por comas. Se prueban en orden y responde el
# primero que pueda. Solo proveedores reales: al agotarse la cadena entra el
# modo degradado, no un proveedor falso.
#
# Las dos tareas tienen restricciones opuestas y por eso no comparten cadena:
# clasificar es volumen alto con error barato (manda latencia y costo);
# responder una política es volumen bajo con error caro (manda fidelidad).
#
# En pruebas y en integración continua: `falso` en las dos. Es el valor por
# defecto si la variable no está definida, y es lo que permite que la suite
# corra sin red y sin credenciales.
RUTA_CLASIFICACION=falso
RUTA_RAG=falso

# --- Credenciales y modelo por proveedor -----------------------------
# Un solo adaptador cubre a todos los que hablan Chat Completions: lo único
# que cambia entre ellos es BASE_URL, API_KEY y MODEL. Añadir un proveedor
# es rellenar tres variables y nombrarlo en la ruta.
#
# Para comparar modelos: cambie solo *_MODEL y vuelva a ejecutar. No hace
# falta tocar código.
#
# ⚠️ Los identificadores de modelo NO se ponen de memoria: cada proveedor
#    publica los suyos y cambian. Consúltelos en su documentación antes de
#    escribirlos aquí. Los ejemplos comentados son orientativos, no una
#    afirmación de que existan hoy.

# Groq — rápido y barato. Buen primario para clasificar.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=

# OpenAI — buen seguimiento de instrucciones. Buen primario para RAG.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# DashScope (Alibaba) — la URL base tiene variantes por región y por eso NO
# se rellena aquí de memoria. Tómela de la consola del proveedor; la ruta
# termina en el modo compatible con Chat Completions.
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=

# OpenRouter — pasarela hacia modelos de varios fabricantes con una sola
# credencial. Es la vía para usar modelos que no exponen Chat Completions
# directamente.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama — modelo local. No necesita credencial: la variable existe igual
# porque el adaptador es el mismo, y un valor cualquiera sirve.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=local
OLLAMA_MODEL=

# --- Corpus de politicas (etapa 3) -----------------------------------
# Carpeta con los PDF de politicas. No se versionan: no son material propio.
# Si no apunta a una carpeta con PDF, el sistema ARRANCA IGUAL con el indice
# vacio y toda consulta de politica se abstiene. Eso es deliberado —fallar al
# arrancar tumbaria tambien la parte que si funciona— pero conviene
# verificarlo: GET /salud devuelve `fragmentos_indexados`, y un cero ahi
# significa que esta variable esta mal.
MAI_RUTA_POLITICAS=

# --- Comportamiento del proveedor ------------------------------------
MAI_LLM_TIMEOUT_S=30
MAI_LLM_REINTENTOS=3

# --- Origenes autorizados desde navegador (etapa 2, opcional) ---------
# Lista separada por comas. VACIO = ningun origen cruzado puede llamar la API.
# NO se acepta "*": permitiria que cualquier pagina abierta en el navegador
# del usuario llame a esta API. Para la pantalla de Angular en desarrollo:
#   MAI_ORIGENES_PERMITIDOS=http://localhost:4200
MAI_ORIGENES_PERMITIDOS=

# --- Registro ---------------------------------------------------------
MAI_NIVEL_LOG=INFO
