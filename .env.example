# =====================================================================
# MAI · variables de entorno — SOLO NOMBRES, VALORES VACÍOS
# Copiar a .env y rellenar. .env está en .gitignore y nunca se versiona.
# =====================================================================

# --- Servicio externo simulado (etapas 1, 2 y 4) ---------------------
# Token público, publicado en el README del material entregado.
# Aun así va por variable de entorno: coherencia sobre excepciones.
MAI_MOCK_URL=http://localhost:8080
MAI_MOCK_TOKEN=
MAI_MOCK_TIMEOUT_S=10
MAI_MOCK_REINTENTOS=3

# --- Enrutamiento del proveedor de IA (ver docs/adr/ADR-004) ---------
# Cadena ordenada, separada por comas. Solo proveedores reales.
# Al agotarse la cadena entra el modo degradado, no un proveedor falso.
# En CI y pruebas: RUTA_CLASIFICACION=falso y RUTA_RAG=falso
RUTA_CLASIFICACION=falso
RUTA_RAG=falso

# --- Credenciales por proveedor --------------------------------------
# Un solo adaptador openai_compatible los cubre a todos: cambian
# base_url, api_key y model. Dejar vacío el que no se use.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# --- Comportamiento del proveedor ------------------------------------
MAI_LLM_TIMEOUT_S=30
MAI_LLM_REINTENTOS=3

# --- Registro ---------------------------------------------------------
MAI_NIVEL_LOG=INFO
